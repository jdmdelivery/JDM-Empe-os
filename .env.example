# Entorno: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=1

# Clave secreta (generar una nueva en producción)
SECRET_KEY=cambiar-esta-clave-por-una-segura-y-larga

# Base de datos
# Desarrollo (SQLite): dejar vacío o usar sqlite
# DATABASE_URL=sqlite:///instance/jdm_empenos.db
# Producción (PostgreSQL / Render):
# DATABASE_URL=postgresql://usuario:password@host:5432/jdm_empenos

# Sesión y seguridad
SESSION_COOKIE_SECURE=0
REMEMBER_COOKIE_DURATION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_INACTIVITY_MINUTES=30

# Negocio
BUSINESS_NAME=JDM Empeños
BUSINESS_CURRENCY=DOP
BUSINESS_CURRENCY_SYMBOL=RD$
BUSINESS_TIMEZONE=America/Santo_Domingo
BUSINESS_LOCALE=es_DO

# Archivos
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Rate limiting
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STORAGE_URI=memory://

# Notificaciones (dejar vacío hasta configurar proveedor)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Render / producción
PORT=5000